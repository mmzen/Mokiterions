{
  "schema": "se-harness-skill-contract-v2",
  "name": "harness-operator-brief",
  "version": "1.0.0",
  "outcome": "Produce one inline decision-ready English brief from supplied bounded source content without changing repository or external state.",
  "activation": {
    "explicit": true,
    "implicit": false,
    "must_not_match": [
      "orient to current repository or artifact state",
      "create or revise an engineering artifact",
      "implement or complete a work order",
      "prepare or decide assurance",
      "apply a lifecycle transition",
      "use Git to commit, push, or merge; release, deploy, use credentials, access a network, or perform an external action"
    ]
  },
  "inputs": [
    {"name": "target", "required": true, "type": "repository-path"},
    {"name": "evaluator-launcher", "required": true, "type": "evaluator-launcher"},
    {"name": "expected-evaluator-version", "required": true, "type": "version"},
    {"name": "expected-evaluator-root", "required": true, "type": "directory-path"},
    {"name": "explicit-skill", "required": true, "type": "skill-name"},
    {"name": "requested-outcome", "required": true, "type": "bounded-text"},
    {"name": "declared-non-effects", "required": true, "type": "text-list"},
    {"name": "source-kind", "required": true, "type": "bounded-text"},
    {"name": "source-payload", "required": true, "type": "json-object"},
    {"name": "protected-content", "required": true, "type": "json-object"},
    {"name": "project-terms", "required": false, "type": "text-list"}
  ],
  "preconditions": [
    {"id": "explicit-selection", "description": "The operator explicitly selected harness-operator-brief for one bounded explanation outcome."},
    {"id": "managed-policy", "description": "The complete managed technical-communication policy is present and passes installed integrity."},
    {"id": "released-evaluator", "description": "The supplied external evaluator identity and installed integrity are current."},
    {"id": "bounded-source", "description": "The supported UTF-8 source and ordered protected-content declaration pass structural validation."}
  ],
  "mutation_class": "read-only",
  "evaluator": {
    "minimum_version": "0.6.0",
    "required_operations": ["version", "identity", "doctor"],
    "optional_operations": [],
    "missing_required": "blocked",
    "missing_optional": "degraded"
  },
  "checkpoints": [
    {"id": "identity-before-effect", "stage": "before-effect", "operation": "identity", "required": true},
    {"id": "integrity-before-effect", "stage": "before-effect", "operation": "doctor", "required": true},
    {"id": "protected-source-before-effect", "stage": "before-effect", "operation": "protected-content-guard", "required": true},
    {"id": "protected-output-after-effect", "stage": "after-effect", "operation": "protected-content-guard", "required": true},
    {"id": "brief-handoff", "stage": "handoff", "operation": "protected-content-guard", "required": true}
  ],
  "effects": {
    "permitted": ["inline-brief-render"],
    "prohibited": [
      "accountable-approval",
      "credential-use",
      "delivery-selection",
      "external-action",
      "git-mutation",
      "lifecycle-transition",
      "network-mutation",
      "release-decision",
      "repository-mutation",
      "verification-decision",
      "work-completion",
      "work-start"
    ],
    "path_source": "none",
    "lifecycle_transitions": []
  },
  "delegation": {"allowed": false, "fallback": "single-agent"},
  "evidence": {
    "receipt_schema": "se-harness-execution-receipt-v1",
    "target_retention": false,
    "required_retained_kinds": []
  },
  "stop_conditions": [
    {"id": "implicit-or-ambiguous-activation", "outcome": "blocked"},
    {"id": "identity-or-policy-invalid", "outcome": "blocked"},
    {"id": "source-or-preservation-invalid", "outcome": "failed"},
    {"id": "current-state-result-required", "outcome": "stopped"},
    {"id": "meaning-clarification-required", "outcome": "stopped"},
    {"id": "unsupported-language-or-purpose", "outcome": "stopped"},
    {"id": "prohibited-effect-requested", "outcome": "stopped"}
  ],
  "outputs": [
    {"name": "skill-result", "schema": "se-harness-skill-result-v1", "retention": "inline"},
    {"name": "execution-receipt", "schema": "se-harness-execution-receipt-v1", "retention": "inline"}
  ]
}
