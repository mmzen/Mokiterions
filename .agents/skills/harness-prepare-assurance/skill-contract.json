{
  "schema": "se-harness-skill-contract-v3",
  "name": "harness-prepare-assurance",
  "version": "2.0.0",
  "outcome": "Prepare one exact-candidate verification record through delegated evaluator preparation and stop before Git or assurance decision.",
  "activation": {
    "explicit": true,
    "implicit": false,
    "must_not_match": [
      "review implementation evidence",
      "verify or reject a verification record",
      "select a delivery path",
      "commit, push, publish, deploy, operate, or use credentials"
    ]
  },
  "inputs": [
    {"name": "target", "required": true, "type": "repository-path"},
    {"name": "evaluator-launcher", "required": true, "type": "evaluator-launcher"},
    {"name": "expected-evaluator-version", "required": true, "type": "version"},
    {"name": "expected-evaluator-root", "required": true, "type": "directory-path"},
    {"name": "explicit-skill", "required": true, "type": "skill-name"},
    {"name": "requested-outcome", "required": true, "type": "bounded-text"},
    {"name": "declared-non-effects", "required": true, "type": "text-list"},
    {"name": "work-orders", "required": true, "type": "artifact-id-list"},
    {"name": "verification-contracts", "required": true, "type": "artifact-id-list"},
    {"name": "evidence-paths", "required": true, "type": "path-list"},
    {"name": "candidate-commit", "required": false, "type": "bounded-text"},
    {"name": "record-id", "required": true, "type": "artifact-id"},
    {"name": "record-destination", "required": true, "type": "repository-path"},
    {"name": "preparation-actor", "required": true, "type": "bounded-text"},
    {"name": "delegation-evidence", "required": true, "type": "json-object"},
    {"name": "completion-proof", "required": true, "type": "json-object"},
    {"name": "evaluator-request", "required": true, "type": "json-object"}
  ],
  "preconditions": [
    {"id": "explicit-selection", "description": "The operator explicitly selected harness-prepare-assurance and one unused VREC identifier."},
    {"id": "released-evaluator", "description": "The supplied external evaluator identity and installed integrity are current."},
    {"id": "implemented-work", "description": "Every selected work order is implemented and governed by the selected verification contracts."},
    {"id": "completion-proof", "description": "The full evaluator-issued completion proof and retained evidence are available."},
    {"id": "phase4-delegation", "description": "The work order delegates exactly delegated-vrec-prepare to the named implementation worker."},
    {"id": "preparation-actor", "description": "The current request names the actor recorded as preparer, not verifier."}
  ],
  "mutation_class": "governed-mutation",
  "evaluator": {
    "minimum_version": "0.6.0",
    "required_operations": ["version", "identity", "doctor", "delegated-workflow-catalog", "delegated-workflow-prepare-vrec"],
    "optional_operations": ["validate-json", "inspect-json"],
    "missing_required": "blocked",
    "missing_optional": "degraded"
  },
  "client": {
    "request_schema": "se-harness-evaluator-client-request-v1",
    "result_schema": "se-harness-evaluator-client-result-v1",
    "workflow_schema": "se-harness-workflow-v4",
    "interface_operation": "delegated-workflow-prepare-vrec",
    "operation_catalog": ["delegated-vrec-prepare"],
    "bundle_owner": "evaluator",
    "target_writer": "evaluator",
    "direct_target_writes": false,
    "canonical_restitution": "required"
  },
  "checkpoints": [
    {"id": "identity-before-effect", "stage": "before-effect", "operation": "identity", "required": true},
    {"id": "integrity-before-effect", "stage": "before-effect", "operation": "doctor", "required": true},
    {"id": "capability-before-effect", "stage": "before-effect", "operation": "delegated-workflow-catalog", "required": true},
    {"id": "delegated-preparation-after-effect", "stage": "after-effect", "operation": "delegated-workflow-prepare-vrec", "required": true},
    {"id": "assurance-stop-handoff", "stage": "handoff", "operation": "decision-packet", "required": true}
  ],
  "effects": {
    "permitted": ["verification-record-prepare"],
    "prohibited": ["accountable-approval", "assurance-decision", "child-delegation", "credential-use", "delivery-selection", "direct-target-write", "external-action", "git-mutation", "lifecycle-authority", "lifecycle-transition", "network-mutation", "parallel-writer", "release-decision", "verification-decision", "work-completion", "work-start"],
    "path_source": "evaluator-derived-vrec-destination",
    "lifecycle_transitions": []
  },
  "delegation": {"allowed": false, "fallback": "single-agent"},
  "evidence": {
    "receipt_schemas": ["se-harness-execution-receipt-v1"],
    "target_retention": true,
    "required_retained_kinds": ["verification-record", "evaluator-evidence", "completion-proof"]
  },
  "stop_conditions": [
    {"id": "implicit-or-ambiguous-activation", "outcome": "blocked"},
    {"id": "phase4-capability-unavailable", "outcome": "blocked"},
    {"id": "invalid-or-missing-delegation", "outcome": "blocked"},
    {"id": "session-conflict", "outcome": "blocked"},
    {"id": "direct-target-write-requested", "outcome": "blocked"},
    {"id": "canonical-restitution-failed", "outcome": "failed"},
    {"id": "git-authorization-required", "outcome": "stopped"},
    {"id": "assurance-decision-required", "outcome": "stopped"}
  ],
  "outputs": [
    {"name": "skill-result", "schema": "se-harness-evaluator-client-result-v1", "retention": "inline"},
    {"name": "execution-receipt", "schema": "se-harness-execution-receipt-v1", "retention": "inline"},
    {"name": "verification-record", "schema": "se-harness-verification-record-v1", "retention": "retained"},
    {"name": "evaluator-evidence", "schema": "se-harness-evidence-set-v1", "retention": "retained"},
    {"name": "assurance-decision-packet", "schema": "se-harness-decision-packet-v2", "retention": "inline"}
  ]
}
